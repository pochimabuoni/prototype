# ---------------------------------------------------------------------------
# POCHI MA BUONI — environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used in emails, auth redirects, Stripe return URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public contact address shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase — from `npx supabase status` (local) or Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used for webhooks, application intake and audited admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use TEST mode keys during development)
STRIPE_SECRET_KEY=
# Recurring $60/month price id (price_...) created in the Stripe dashboard
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=

# Resend (optional locally — without it, emails are logged instead of sent)
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend
EMAIL_FROM="Pochi Ma Buoni <membership@your-verified-domain.com>"
# Optional: receives a notification for every new application
ADMIN_NOTIFICATION_EMAIL=
